{
  "name": "tuitv",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "dev": "pnpm --filter @tuitv/web dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "test:e2e": "pnpm --filter @tuitv/web test:e2e",
    "build:tizen": "pnpm --filter @tuitv/tizen build",
    "test:tizen": "pnpm --filter @tuitv/tizen test:e2e",
    "fixtures:update": "pnpm --filter @tuitv/business-rules fixtures:update"
  },
  "devDependencies": {
    "turbo": "^2.11.11",
    "typescript": "^5.9.0"
  }
}
